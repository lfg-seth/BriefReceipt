# Saved automatically after a successful iCloud Calendar sign-in in the local app.
# You can also fill these in locally before starting the server.
# Never prefix credentials with VITE_: that prefix exposes values to the browser.
ICLOUD_EMAIL=
ICLOUD_APP_PASSWORD=

# Optional: saved after Connect OpenAI verifies access with a synthetic test.
# Used only by the local server; never use a VITE_ prefix.
OPENAI_API_KEY=

# Optional: saved after Connect Guardian checks your developer key.
# Server only; never use a VITE_ prefix. Headlines are excluded from AI processing.
GUARDIAN_API_KEY=

# Optional: saved after Connect Alpaca verifies your Paper Trading credentials.
# Free IEX data only; server only. Never use a VITE_ prefix.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
